          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_messages_fts_AFTER_INSERT AFTER INSERT ON `messages` BEGIN INSERT INTO `messages_fts`(`docid`, `text`, `chatId`, `accountId`) VALUES (NEW.`rowid`, NEW.`text`, NEW.`chatId`, NEW.`accountId`); END"
        ]
